{
  "name": "appointy-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Appointy - Doctor Appointment Booking Platform",
  "scripts": {
    "postinstall": "npm --prefix backend install",
    "start": "npm --prefix backend run start",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:admin": "npm --prefix admin run dev",
    "dev:backend": "npm --prefix backend run server",
    "build:frontend": "npm --prefix frontend run build",
    "build:admin": "npm --prefix admin run build",
    "build": "npm run build:frontend && npm run build:admin"
  }
}
